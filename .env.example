# Токен вашего Telegram-бота от @BotFather (бесплатно)
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Путь к локальной базе данных SQLite (бесплатно, не требует отдельного сервера БД)
DB_PATH=data/bot_database.sqlite3

# ============================================================================
# ОПЦИОНАЛЬНО: бесплатная LLM для адаптации резюме.
# Достаточно ОДНОГО ключа. Если задать несколько — бот будет пробовать их по
# очереди (кончилась квота у одного → уходит к следующему). Если ключей нет,
# работает встроенный локальный архитектор резюме, бот не падает.
# Проверить, что подключилось: команда /llm в боте.
# ============================================================================

# 1) Google Gemini (free tier Flash/Flash-Lite): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 2) Groq (free tier, быстрый Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3) Cerebras (free tier, ~1 млн токенов/день): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# 4) Mistral La Plateforme (Experiment tier): https://console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# 5) OpenRouter (модели с суффиксом :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# 6) Любой свой OpenAI-совместимый эндпоинт (в т.ч. локальная Ollama: http://localhost:11434/v1)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Порядок перебора провайдеров и выбор единственного (необязательно)
LLM_ORDER=
LLM_PROVIDER=
# Таймаут одного запроса к модели (сек) и лимит длины текста резюме (символов)
LLM_TIMEOUT=75
LLM_MAX_INPUT_CHARS=16000

# Показывать ли в меню блок «идеальное резюме» (Золотой стандарт + пример Executive CV).
# По умолчанию 0 — пункты скрыты, команды /gold_standard и /example_cv отвечают уведомлением.
SHOW_IDEAL_RESUME_UI=0

# Настройки парсера вакансий
HTTP_TIMEOUT=15
MAX_VACANCIES_PER_MESSAGE=10
