# Токен вашего Telegram-бота от @BotFather (бесплатно)
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Путь к локальной базе данных SQLite (бесплатно, не требует отдельного сервера БД)
DB_PATH=data/bot_database.sqlite3

# ОПЦИОНАЛЬНО: Бесплатный OpenAI-совместимый LLM API (например Groq Free Tier, OpenRouter Free или локальная Ollama)
# Если оставить пустым — бот работает на встроенном бесплатном локальном алгоритмическом ATS/STAR-оптимизаторе!
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Настройки парсера вакансий
HTTP_TIMEOUT=15
MAX_VACANCIES_PER_MESSAGE=10
